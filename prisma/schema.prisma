datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  COMPANY
  ADMIN
  UNASSIGNED
  USER
  RECRUITER
}

enum ExperienceLevel {
  Entry
  Mid
  Senior
  Expert
}

// ─── NextAuth required models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Auth
  password String? // Nullable: OAuth users won't have a password

  // Onboarding & verification
  isOnboarded Boolean @default(false)
  isVerified  Boolean @default(false)

  // Profile metadata (set during onboarding)
  country         String?
  category        String? // e.g. Tech, Design, Marketing, Finance, Healthcare
  experienceLevel String? // Entry | Mid | Senior | Expert

  role      Role     @default(UNASSIGNED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  sampleLinks SampleLink[]
  jobsPosted  Job[]
  company     Company?
}

model Candidate {
  id       String   @id @default(cuid())
  fullName String
  headline String?
  bio      String?
  skills   String[]

  // Location & filtering
  location        String?
  country         String?
  category        String? // e.g. Tech, Design, Marketing
  experienceLevel String? @default("Mid") // Entry | Mid | Senior | Expert

  // Source info
  sourceUrl  String?
  isExternal Boolean @default(false)

  // Legacy fields from MongoDB migration
  jobTitle             String?
  profileSource        String?
  profileUrl           String?
  imageUrl             String?
  totalYearsExperience Int?    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String  @id @default(cuid())
  name        String
  description String?
  website     String?
  logoUrl     String?

  // Location & filtering
  location String?
  country  String?
  category String? // Industry: Tech, Design, Marketing, Finance, Healthcare

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String  @id @default(cuid())
  title       String
  description String
  salaryRange String?
  isActive    Boolean @default(true)

  // Location & filtering
  location        String
  country         String?
  category        String? // e.g. Tech, Design, Marketing
  experienceLevel String? // Entry | Mid | Senior | Expert

  companyName String
  postedById  String
  postedBy    User     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SampleLink {
  id          String   @id @default(cuid())
  title       String
  urlSlug     String   @unique @default(cuid())
  targetUrl   String
  isActive    Boolean  @default(true)
  viewCount   Int      @default(0)
  maxViews    Int?
  watermark   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
